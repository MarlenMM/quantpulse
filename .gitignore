# Environments
.env
.venv/
venv/
.python-version.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Package manager
uv.lock.tmp

# Databases & data caches
*.db
*.sqlite
*.sqlite3
data/
*.parquet
.cache/

# EXCEPT: the nightly-refreshed live-demo database (Section 17/ADR 4.4) is
# deliberately committed by .github/workflows/refresh_data.yml so Streamlit
# Community Cloud's auto-redeploy-on-push picks up fresh data. Kept at a
# distinct root-level filename -- never `quantpulse.db`, your own local dev
# DB above -- specifically so the two can never collide or get force-pushed
# over each other.
!quantpulse_demo.db

# Testing & tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage

# Streamlit
.streamlit/secrets.toml

# Notebooks
.ipynb_checkpoints/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Deploy-shaped virtualenv built by ./run.sh from requirements.txt.
.venv-app/

# Pre-rendered API responses for the GitHub Pages build (generated by
# scripts/build_static_site.py from quantpulse_demo.db -- ~29 MB, never committed).
frontend/public/data/
